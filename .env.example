# Copy this file to .env and replace every value marked CHANGE_ME.
# Never commit the real .env file to GitHub.

SHLUZ_ENVIRONMENT=development
SHLUZ_BOOTSTRAP_API_TOKEN=CHANGE_ME_LONG_RANDOM_TOKEN
SHLUZ_ADMIN_USERNAME=admin
SHLUZ_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD

# Persistent database. The default is a local SQLite file in ./data.
SHLUZ_DATABASE_URL=sqlite+pysqlite:///./data/shluz.db
SHLUZ_DATABASE_ECHO=false

# AI provider. Keep "mock" for free local testing.
SHLUZ_ACTIVE_PROVIDER=mock
SHLUZ_VENICE_API_KEY=
SHLUZ_VENICE_BASE_URL=https://api.venice.ai/api/v1
SHLUZ_VENICE_TIMEOUT_SECONDS=30
SHLUZ_VENICE_ANALYTICS_LOOKBACK=7d

# PostgreSQL/Supabase example. Put the real password only in .env or hosting Secrets.
# SHLUZ_DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@HOST:6543/postgres?sslmode=require

# Future Supabase Auth integration. Not used by the current accounting layer.
# SHLUZ_SUPABASE_URL=
# SHLUZ_SUPABASE_SERVICE_ROLE_KEY=
