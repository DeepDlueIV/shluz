# Copy to .env.telegram. This file is for the BOT only, never copy gateway .env here.
# Create a dedicated test bot through Telegram @BotFather. Never publish its real token.
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOTFATHER_TOKEN

# These three paths are overridden in compose.yaml for the containers.
# These values below are for running `python -m telegram_bot` from this repository.
TELEGRAM_GATEWAY_URL=http://127.0.0.1:8000
TELEGRAM_ACCESS_FILE=secrets/telegram-access.json
TELEGRAM_DATABASE_PATH=data/telegram.sqlite

TELEGRAM_DEFAULT_MODEL=mock-chat
TELEGRAM_REQUEST_TIMEOUT=120
TELEGRAM_CONTEXT_CHAR_LIMIT=24000
TELEGRAM_MAX_INPUT_CHARS=8000
TELEGRAM_MAX_RESPONSE_CHARS=100000
TELEGRAM_MAX_PARALLEL_REQUESTS=4
TELEGRAM_COOLDOWN_SECONDS=2
TELEGRAM_HISTORY_RETENTION_DAYS=30
TELEGRAM_MAX_DIALOGS=20
TELEGRAM_MAX_SAVED_TURNS=200
TELEGRAM_MAX_TEXT_PARTS=6
TELEGRAM_SUPPORT_CONTACT=Обратитесь к администратору тестирования.
