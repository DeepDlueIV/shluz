# Telegram bot token. Empty value keeps bot disabled.
SHLUZ_TELEGRAM_BOT_TOKEN=

# Allowed Telegram numeric user IDs separated by commas.
# Empty means nobody is allowed.
SHLUZ_TELEGRAM_ALLOWED_IDS=

# Internal gateway URL in compose network.
SHLUZ_GATEWAY_URL=http://shluz:8000

# Local bot storage.
SHLUZ_TELEGRAM_DB_PATH=./data/telegram.db
